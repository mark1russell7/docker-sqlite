{
  "$schema": "https://json.schemastore.org/package",
  "name": "@docker-sqlite/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of docker-sqlite: real SQLite in the browser. Edit the migrations, run them, and query the rows with the helpers of the package.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/docker-sqlite": "workspace:*",
    "@mark1russell7/site-pages": "^0.1.10",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "@mark1russell7/cue": "^2.1.1",
    "@types/node": "^22.0.0",
    "@types/sql.js": "^1.4.11",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
